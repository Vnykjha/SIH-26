{
  "firestore": {
    "rules": "firestore.rules"
  },
  "hosting": {
    "public": "web_dashboard/dist",
    "ignore": [
      "firebase.json",
      "**/.*",
      "**/node_modules/**"
    ],
    "rewrites": [
      {
        "source": "**",
        "destination": "/index.html"
      }
    ],
    "predeploy": [
      "npm.cmd --prefix web_dashboard run build"
    ]
  }
}